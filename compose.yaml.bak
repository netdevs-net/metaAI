services:
  metaisploit-assistant:
    build: .
    container_name: metaisploit-assistant
    tty: true
    stdin_open: true
    volumes:
      - ./:/app
      - ./models:/app/models
      - ./data:/app/data
    environment:
      - METASPLOIT_ROOT=/opt/metasploit-framework
      - GPT4ALL_MODEL_PATH=/app/models
    ports:
      - "8080:8080"
    depends_on:
      - metasploit
    networks:
      - metasploit-net

  metasploit:
    image: metasploitframework/metasploit-framework
    container_name: metasploit
    tty: true
    stdin_open: true
    volumes:
      - ./data:/data
      - ./docker/msfconsole.rc:/usr/src/metasploit-framework/docker/msfconsole.rc
    ports:
      - "4444:4444"
      - "55552:55552"
      - "55553:55553"
    networks:
      - metasploit-net
    entrypoint: ["./msfconsole", "-r", "docker/msfconsole.rc", "-y", "$APP_HOME/config/database.yml"]

  dvwa:
    image: vulnerables/web-dvwa
    container_name: dvwa
    ports:
      - "8081:80"
    environment:
      - MYSQL_ROOT_PASSWORD=dvwa
      - MYSQL_PASSWORD=dvwa
      - MYSQL_USER=dvwa
      - MYSQL_DATABASE=dvwa
    networks:
      - metasploit-net
    restart: unless-stopped

volumes:
  models:
  data:

networks:
  metasploit-net:
    driver: bridge