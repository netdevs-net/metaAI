# Copy to .env-dev and fill in locally. Never commit the filled-in file.

# Path to the Metasploit checkout used by the lab
METASPLOIT_ROOT=/path/to/metasploit-framework
METASPLOIT_INSTALL_ROOT=/path/to/metasploit-framework/install

# Password for the msfrpcd RPC listener. Generate a fresh one per environment:
#   openssl rand -base64 24
MSGRPC_PASS=

# Postgres connection string for the lab database, e.g.
#   postgresql://user:password@localhost:5432/metaai
DATABASE_URL=
