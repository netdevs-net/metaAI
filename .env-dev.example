# Copy to .env-dev. The values below are deliberately fake placeholders, not
# secrets — the lab runs with them as-is. Replace them for anything that is not
# a throwaway local stack.

METASPLOIT_ROOT=/path/to/metasploit-framework
METASPLOIT_INSTALL_ROOT=/path/to/metasploit-framework/install

# msfrpcd RPC listener. Generate a real one with: openssl rand -base64 24
MSGRPC_PASS=CHANGEME-local-lab-only

# Postgres. Must match POSTGRES_PASSWORD used by the db service.
POSTGRES_PASSWORD=CHANGEME-local-lab-only
DATABASE_URL=postgresql://msf:CHANGEME-local-lab-only@db:5432/msf
